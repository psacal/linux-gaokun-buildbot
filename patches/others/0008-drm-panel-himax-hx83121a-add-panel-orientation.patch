From 0000000000000000000000000000000000000000 Mon Sep 17 00:00:00 2001
From: psacal <2658842706@qq.com>
Date: Thu, 3 Jun 2026 00:00:00 +0800
Subject: [PATCH] drm/panel: himax-hx83121a: expose panel orientation

Set panel_orientation on the DRM connector so userspace (mutter) can
read the "panel orientation" property and enable automatic screen
rotation via PanelOrientationManaged.

Uses drm_connector_set_panel_orientation() only when the connector is
fully registered, avoiding a crash during early probe. Otherwise falls
back to setting display_info.panel_orientation directly, which gets
picked up on the next modeset.

Signed-off-by: psacal <2658842706@qq.com>
---
 drivers/gpu/drm/panel/panel-himax-hx83121a.c | 8 ++++++++
 1 file changed, 8 insertions(+)

diff --git a/drivers/gpu/drm/panel/panel-himax-hx83121a.c b/drivers/gpu/drm/panel/panel-himax-hx83121a.c
index 028b615c6..0000000000 100644
--- a/drivers/gpu/drm/panel/panel-himax-hx83121a.c
+++ b/drivers/gpu/drm/panel/panel-himax-hx83121a.c
@@ -20,6 +20,7 @@
 #include <drm/drm_mipi_dsi.h>
 #include <drm/drm_modes.h>
 #include <drm/drm_panel.h>
+#include <drm/drm_connector.h>

 #include <video/mipi_display.h>

@@ -182,6 +183,12 @@ static int himax_get_modes(struct drm_panel *panel,
 	connector->display_info.width_mm = desc->width_mm;
 	connector->display_info.height_mm = desc->height_mm;
 	connector->display_info.bpc = desc->bpc;
+	if (connector->registration_state == DRM_CONNECTOR_REGISTERED)
+		drm_connector_set_panel_orientation(connector,
+						     DRM_MODE_PANEL_ORIENTATION_NORMAL);
+	else
+		connector->display_info.panel_orientation =
+			DRM_MODE_PANEL_ORIENTATION_NORMAL;

 	return num_modes;
 }
